{
  "name": "magiclists",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "assets:stamp": "node scripts/build-asset-versions.mjs",
    "check:assets": "node scripts/build-asset-versions.mjs --check",
    "check:modules": "node --experimental-vm-modules scripts/check-module-graph.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "prepare": "node scripts/git-hooks/install.mjs",
    "verify": "npm run check:assets && npm run check:modules && npm test"
  },
  "devDependencies": {
    "acorn": "^8.19.0"
  }
}
